rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (userExists(request.auth.uid) && getUserData(request.auth.uid).role == 'admin')
      );
    }

    function isNotBanned() {
      return !isAuthenticated() || (
        !userExists(request.auth.uid) || getUserData(request.auth.uid).status != 'banned'
      );
    }

    // Product stock update validation during checkout
    function isStockCheckoutUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
    }

    // Product review and rating update validation
    function isReviewUpdate() {
      return isAuthenticated()
        && isNotBanned()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews', 'rating', 'averageRating', 'reviewCount']);
    }

    // 1. Products Collection Rules
    match /products/{productId} {
      // Products are publicly readable by everyone
      allow read: if true;

      // Creation and deletion are restricted to admins only
      allow create, delete: if isAdmin();

      // Updates allowed for:
      // - Admins (any field modification)
      // - Checkout process (strictly decrementing stock without going negative)
      // - Authenticated non-banned users submitting reviews
      allow update: if isAdmin() || isStockCheckoutUpdate() || isReviewUpdate();

      // Subcollection for reviews: products/{productId}/reviews/{reviewId}
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && isNotBanned() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      }
    }

    // 2. Users Collection Rules
    match /users/{userId} {
      // User can read their own profile, or admins can read any user profile
      allow read: if isOwner(userId) || isAdmin();

      // User can create their document on signup:
      // Must be their own UID, role must be 'customer', status must be 'active'
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'customer'
                    && request.resource.data.status == 'active';

      // Updates:
      // - Admins can update any field (including role and status)
      // - Users can update their own profile, but CANNOT touch 'role' or 'status'
      allow update: if isAdmin() || (
        isOwner(userId)
        && isNotBanned()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
      );

      // Deletion is restricted to admins
      allow delete: if isAdmin();
    }

    // 3. Orders Collection Rules
    match /orders/{orderId} {
      // Read access:
      // - Admins can read all orders
      // - Authenticated users can only read orders where userId matches their UID
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Create access:
      // - Authenticated user creating order with their own UID, or guest
      // - Initial status must strictly be 'pending'
      allow create: if isNotBanned() && (
        (isAuthenticated() && request.resource.data.userId == request.auth.uid) ||
        (request.resource.data.userId == 'guest')
      ) && request.resource.data.status == 'pending';

      // Update access:
      // - Updating order status (or any order fields) is strictly restricted to admins
      allow update: if isAdmin();

      // Delete access:
      // - Only admins can delete orders
      allow delete: if isAdmin();
    }

    // 4. Store Settings & Global Configuration
    match /settings/{docId} {
      // Settings (Store Name, Logo, Maintenance status) are publicly readable
      allow read: if true;
      // Only admins can modify store settings and branding
      allow write: if isAdmin();
    }
  }
}
